\@writefile{lof}{\contentsline {figure}{\numberline {D1}{\ignorespaces Comparison between scaling and squaring as implemented here and \texttt  {Scipy}'s \texttt  {expm\textunderscore multiply}, considering relative error and runtime. (a), (c) Relative error versus matrix norm. (b), (d) Ratios of runtime and $\mu $ (i.e. number of matrix-vector multiplications) between our and \texttt  {Scipy}'s implementations as functions of the matrix norm. The matrix norm $\left |\left |-iH\Delta t\right |\right |_2$ is varied by increasing $\Delta t\in [1,10]$. In all panels, colors encode different error tolerances $\tau $. The results of the first and second row are obtained based on cavity-transmon and three coupled transmons Hamiltonians, respectively. The system parameters of these two Hamiltonian are the same as the ones given in the captions of Figs.\ \ref {fig:state_time}, \ref {fig:gate}, respectively. }}{15}{figure.caption.13}\protected@file@percent }
\newlabel{fig:sas numerical experiments}{{D1}{15}{Comparison between scaling and squaring as implemented here and \texttt {Scipy}'s \texttt {expm\textunderscore multiply}, considering relative error and runtime. (a), (c) Relative error versus matrix norm. (b), (d) Ratios of runtime and $\mu $ (i.e. number of matrix-vector multiplications) between our and \texttt {Scipy}'s implementations as functions of the matrix norm. The matrix norm $\norm {-iH\Delta t}_2$ is varied by increasing $\Delta t\in [1,10]$. In all panels, colors encode different error tolerances $\tau $. The results of the first and second row are obtained based on cavity-transmon and three coupled transmons Hamiltonians, respectively. The system parameters of these two Hamiltonian are the same as the ones given in the captions of Figs.\ \ref {fig:state_time}, \ref {fig:gate}, respectively}{figure.caption.13}{}}
