\@writefile{lof}{\contentsline {figure}{\numberline {2.1}{\ignorespaces Comparison between scaling and squaring as implemented here and \texttt  {Scipy}'s \texttt  {expm\_multiply}, considering relative error and runtime. (a),~(c)~Relative error versus matrix norm. (b),~(d)~Ratios of runtime and $\mu $ (i.e.\ number of matrix-vector multiplications) between the two implementations as functions of the matrix norm. The matrix norm $\left |\left |-iH\Delta t\right |\right |_2$ is varied by increasing $\Delta t\in [1,10]$. In all panels, colors encode different error tolerances $\tau $. The results of the first and second rows are obtained based on the cavity--transmon and three-coupled-transmons Hamiltonians, respectively. The system parameters of these two Hamiltonians are the same as those given in the captions of Figs.~\ref {fig:state_time} and~\ref {fig:gate}.}}{18}{figure.2.1}\protected@file@percent }
\newlabel{fig:sas_numerical_experiments}{{2.1}{18}{Comparison between scaling and squaring as implemented here and \texttt {Scipy}'s \texttt {expm\_multiply}, considering relative error and runtime. (a),~(c)~Relative error versus matrix norm. (b),~(d)~Ratios of runtime and $\mu $ (i.e.\ number of matrix-vector multiplications) between the two implementations as functions of the matrix norm. The matrix norm $\norm {-iH\Delta t}_2$ is varied by increasing $\Delta t\in [1,10]$. In all panels, colors encode different error tolerances $\tau $. The results of the first and second rows are obtained based on the cavity--transmon and three-coupled-transmons Hamiltonians, respectively. The system parameters of these two Hamiltonians are the same as those given in the captions of Figs.~\ref {fig:state_time} and~\ref {fig:gate}}{figure.2.1}{}}
\newlabel{fig:sas_numerical_experiments@cref}{{[figure][1][2]2.1}{[1][18][]18}}
