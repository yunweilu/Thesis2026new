\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces Numerical evaluation and time-domain validation of the total cavity dephasing rate under sweet-spot driving. (a) Total dephasing rate $\Gamma _{\phi ,\mathrm  {total}}$ extracted from full-system simulations as a function of detuning $\Delta _{bd}$, with the drive amplitude chosen at each detuning to satisfy the sweet-spot condition. $S_0$ denotes the amplitude of $1/f$ flux noise. (b) DRAG-style adiabatic ramp pulse. (c) Time-domain decay of $P_X(t)=\mathrm  {Tr}\!\left [\rho (t)\,X(t)\right ]$, with $X(t)=\ket {\phi _{g,1}(t)}\!\bra {\phi _{g,0}(t)}+\mathrm  {H.c.}$. The time-dependent Floquet states are labeled by their bare-state correspondence. The driven system exhibits a cavity dephasing time of $\sim 2~\mathrm  {ms}$, compared to $\sim 100~\mu \mathrm  {s}$ in the undriven case.}}{91}{figure.7.1}\protected@file@percent }
\newlabel{fig:total_rate}{{7.1}{91}{Numerical evaluation and time-domain validation of the total cavity dephasing rate under sweet-spot driving. (a) Total dephasing rate $\Gamma _{\phi ,\mathrm {total}}$ extracted from full-system simulations as a function of detuning $\Delta _{bd}$, with the drive amplitude chosen at each detuning to satisfy the sweet-spot condition. $S_0$ denotes the amplitude of $1/f$ flux noise. (b) DRAG-style adiabatic ramp pulse. (c) Time-domain decay of $P_X(t)=\mathrm {Tr}\!\left [\rho (t)\,X(t)\right ]$, with $X(t)=\ket {\phi _{g,1}(t)}\!\bra {\phi _{g,0}(t)}+\mathrm {H.c.}$. The time-dependent Floquet states are labeled by their bare-state correspondence. The driven system exhibits a cavity dephasing time of $\sim 2~\mathrm {ms}$, compared to $\sim 100~\mu \mathrm {s}$ in the undriven case}{figure.7.1}{}}
\newlabel{fig:total_rate@cref}{{[figure][1][7]7.1}{[1][82][]91}}
