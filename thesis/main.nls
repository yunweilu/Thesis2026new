
\begin{thenomenclature} 
\nomgroup{A}
  \item [{$\bar{\omega}_b$}]\begingroup Lamb-shifted FTT frequency\nomeqref {0}\nompageref{vi}
  \item [{$\bar{\omega}_c$}]\begingroup Lamb-shifted cavity frequency\nomeqref {0}\nompageref{vi}
  \item [{$\chi$}]\begingroup dispersive shift\nomeqref {0}\nompageref{vi}
  \item [{$\delta\omega_b(t)$}]\begingroup FTT-frequency fluctuation\nomeqref {0}\nompageref{vi}
  \item [{$\delta\Phi(t)$}]\begingroup its fluctuation\nomeqref {0}\nompageref{vi}
  \item [{$\Delta_m$}]\begingroup relevant detuning $\Delta_m\equiv \Delta_{bd}+m\chi$\nomeqref {0}\nompageref{vi}
  \item [{$\Delta_{bc}$}]\begingroup detuning $\Delta_{bc}=\omega_b-\omega_c$\nomeqref {0}\nompageref{vi}
  \item [{$\Delta_{bd}$}]\begingroup FTT--drive detuning\nomeqref {0}\nompageref{vi}
  \item [{$\Gamma_{\phi,\mathrm{total}}$}]\begingroup total cavity dephasing rate\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{\phi,n\rightarrow m}$}]\begingroup dephasing rate of cavity transitions induced by FTT-frequency fluctuations\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{b\downarrow}$}]\begingroup FTT relaxation at rate $\gamma_{b\downarrow}$ (the FTT energy-relaxation rate)\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{b\uparrow}^{1/f,\mathrm{un}}$}]\begingroup transverse-noise-induced excitation rate\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{b\uparrow}^{\mathrm{sel}}$}]\begingroup FTT heating at a rate\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{b\uparrow}^{\mathrm{un}}$}]\begingroup drive-induced FTT excitation\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{c\phi}^{\mathrm{sel}}$}]\begingroup cavity pure dephasing at a rate\nomeqref {0}\nompageref{vi}
  \item [{$\gamma_{c\phi}^{\mathrm{un}}$}]\begingroup cavity pure dephasing\nomeqref {0}\nompageref{vi}
  \item [{$\kappa$}]\begingroup Number of stored Hamiltonian matrix elements\nomeqref {4.0}\nompageref{35}
  \item [{$\mu$}]\begingroup Number of matrix-vector multiplications required for propagator-state product evaluation\nomeqref {3.52}\nompageref{29}
  \item [{$\Omega_0$}]\begingroup amplitude of a coherent drive\nomeqref {0}\nompageref{vi}
  \item [{$\omega_\mathrm{ir}$}]\begingroup infrared cutoff of the $1/f$ noise spectrum\nomeqref {0}\nompageref{vi}
  \item [{$\omega_d$}]\begingroup drive frequency\nomeqref {0}\nompageref{vi}
  \item [{$\Phi$}]\begingroup static flux bias\nomeqref {0}\nompageref{vi}
  \item [{$\rho_d$}]\begingroup density matrix in the effective drive frame\nomeqref {0}\nompageref{vi}
  \item [{$\varepsilon_I$, $\varepsilon_Q$}]\begingroup Control envelopes in the $I$ and $Q$ quadratures\nomeqref {5.2}\nompageref{46}
  \item [{$\widetilde{\Delta}_{bd}$}]\begingroup shifted FTT detuning $\widetilde{\Delta}_{bd}\equiv \Delta_{bd}-\Omega_0^2/K$\nomeqref {0}\nompageref{vi}
  \item [{$\widetilde{\gamma}_{b\downarrow}^{\mathrm{un}}$}]\begingroup drive-renormalized FTT relaxation\nomeqref {0}\nompageref{vi}
  \item [{$\widetilde{\gamma}_{c\downarrow}^{\mathrm{un}}$}]\begingroup renormalized cavity decay\nomeqref {0}\nompageref{vi}
  \item [{$\widetilde{\omega}_{c,m\rightarrow m+1}$}]\begingroup net cavity transition frequency between adjacent cavity levels\nomeqref {0}\nompageref{vi}
  \item [{$b$}]\begingroup annihilates an excitation in the FTT mode\nomeqref {0}\nompageref{vi}
  \item [{$c$}]\begingroup annihilates an excitation in the cavity mode\nomeqref {0}\nompageref{vi}
  \item [{$D_{m\rightarrow m+1}$}]\begingroup susceptibility of the net cavity frequency to FTT-frequency fluctuation\nomeqref {0}\nompageref{vi}
  \item [{$g$}]\begingroup coupling strength\nomeqref {0}\nompageref{vi}
  \item [{$h_c$}]\begingroup Control operator coupling the field to the system\nomeqref {3.1}\nompageref{16}
  \item [{$H_s$}]\begingroup Static system Hamiltonian\nomeqref {3.1}\nompageref{16}
  \item [{$K$}]\begingroup FTT anharmonicity\nomeqref {0}\nompageref{vi}
  \item [{$K_\text{q}$}]\begingroup Transmon anharmonicity (self-Kerr)\nomeqref {5.2}\nompageref{46}
  \item [{$P_X(t)$}]\begingroup coherence signal\nomeqref {0}\nompageref{vi}
  \item [{$S_0$}]\begingroup sets the flux-noise amplitude\nomeqref {0}\nompageref{vi}
  \item [{$S_{1/f}(\omega)$}]\begingroup power spectral density of $1/f$ flux noise\nomeqref {0}\nompageref{vi}
  \item [{$T_2$}]\begingroup dephasing time extracted from an exponential fit to $P_X(t)$\nomeqref {0}\nompageref{vi}
  \item [{$U_n$}]\begingroup Short-time propagator for time step $n$\nomeqref {3.3}\nompageref{17}
  \item [{$X(t)$}]\begingroup coherence operator\nomeqref {0}\nompageref{vi}
  \item [{FTT}]\begingroup Flux-Tunable Transmon\nomeqref {0}\nompageref{vi}
  \item [{GRAPE}]\begingroup Gradient Ascent Pulse Engineering\nomeqref {3.0}\nompageref{15}
  \item [{LINC}]\begingroup Linear INductive Coupler\nomeqref {0}\nompageref{vi}
  \item [{QEC}]\begingroup quantum error-correction\nomeqref {0}\nompageref{vi}
  \item [{SNAIL}]\begingroup Superconducting Nonlinear Asymmetric Inductive eLement\nomeqref {0}\nompageref{vi}

\end{thenomenclature}
