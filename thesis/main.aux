\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces \textbf  {Driven sweet-spot protection for bosonic encodings} (\(\Omega _0/2\pi =10\,\mathrm  {MHz}\) throughout). \emph  {Binomial code}---\textbf  {(a)}~Dephasing rate \(\gamma _{\phi ,n\rightarrow m}\) of cavity transitions due to FTT-frequency fluctuations as a function of \(\Delta _{bd}\); the star marks \(\Delta _{bd}/2\pi =-30\,\mathrm  {MHz}\), where all relevant \(\gamma _{\phi ,n\rightarrow m}\) are suppressed by at least \(\sim \!13\times \). \textbf  {(b)}~Wigner function of \(|+_L\rangle \) at \(t=300\,\mu \mathrm  {s}\): the driven case retains the interference fringes that are lost without the drive. \emph  {Dual-rail encoding}---\textbf  {(c)}~Dephasing rate \(\gamma _{\phi ,0\rightarrow 1}^{(i)}\) for each cavity as a function of \(\Delta _{bd}\); both cavities exhibit \(\sim 10\times \) lower dephasing near \(-\Delta _{bd}/2\pi \sim 29\,\mathrm  {MHz}\). \textbf  {(d)}~Logical-subspace tomography for one dual-rail qubit: the drive suppresses dephasing, while leakage from single-photon loss remains unchanged.}}{95}{figure.8.1}\protected@file@percent }
\newlabel{fig:qec_plot}{{8.1}{95}{\textbf {Driven sweet-spot protection for bosonic encodings} (\(\Omega _0/2\pi =10\,\mathrm {MHz}\) throughout). \emph {Binomial code}---\textbf {(a)}~Dephasing rate \(\gamma _{\phi ,n\rightarrow m}\) of cavity transitions due to FTT-frequency fluctuations as a function of \(\Delta _{bd}\); the star marks \(\Delta _{bd}/2\pi =-30\,\mathrm {MHz}\), where all relevant \(\gamma _{\phi ,n\rightarrow m}\) are suppressed by at least \(\sim \!13\times \). \textbf {(b)}~Wigner function of \(|+_L\rangle \) at \(t=300\,\mu \mathrm {s}\): the driven case retains the interference fringes that are lost without the drive. \emph {Dual-rail encoding}---\textbf {(c)}~Dephasing rate \(\gamma _{\phi ,0\rightarrow 1}^{(i)}\) for each cavity as a function of \(\Delta _{bd}\); both cavities exhibit \(\sim 10\times \) lower dephasing near \(-\Delta _{bd}/2\pi \sim 29\,\mathrm {MHz}\). \textbf {(d)}~Logical-subspace tomography for one dual-rail qubit: the drive suppresses dephasing, while leakage from single-photon loss remains unchanged}{figure.8.1}{}}
\newlabel{fig:qec_plot@cref}{{[figure][1][8]8.1}{[1][94][]95}}
